PORT=3000
NODE_ENV=development
APP_NAME=Drug Authentication API
LOG_LEVEL=info
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
REQUEST_BODY_LIMIT=32kb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=drug_auth_db
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
VERIFY_RATE_LIMIT_WINDOW_MS=60000
VERIFY_RATE_LIMIT_MAX_REQUESTS=30
ABUSE_WINDOW_MS=600000
ABUSE_FAILURE_THRESHOLD=8
ABUSE_BASE_BLOCK_MS=30000
ABUSE_MAX_BLOCK_MS=900000
ABUSE_REPEATED_CODE_THRESHOLD=12
ABUSE_UNIQUE_FAILURE_THRESHOLD=40
FORENSIC_WINDOW_MS=600000
FORENSIC_DISTINCT_IPS_THRESHOLD=2
FORENSIC_EXCESSIVE_PRODUCT_ATTEMPTS=20
FORENSIC_EXCESSIVE_BATCH_ATTEMPTS=15
FORENSIC_EXCESSIVE_ITEM_ATTEMPTS=10
FORENSIC_RAPID_SCAN_WINDOW_MS=30000
FORENSIC_RAPID_SCAN_THRESHOLD=8
FORENSIC_GEO_INCONSISTENT_DISTANCE_KM=200
FORENSIC_GEO_INCONSISTENT_WINDOW_MS=86400000
FORENSIC_STATUS_WINDOW_MS=86400000
